APP_NAME="Score System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://192.168.88.13:6868
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Runtime API kết nối bằng role KHÔNG sở hữu bảng => Row-Level Security có hiệu lực
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=score
DB_USERNAME=score_app
DB_PASSWORD=score_app
# Role owner, chỉ dùng để chạy migration: php artisan migrate --database=pgsql_owner
DB_OWNER_USERNAME=score
DB_OWNER_PASSWORD=score

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

# Kho file S3 (dev: SeaweedFS trong docker compose)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=score
AWS_SECRET_ACCESS_KEY=score-secret-dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=score-files
AWS_ENDPOINT=http://seaweedfs:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

# OIDC (Keycloak). Issuer = URL công khai; JWKS lấy qua mạng nội bộ docker.
OIDC_ISSUER=http://192.168.88.13:6868/auth/realms/score
OIDC_JWKS_URI=http://keycloak:8080/auth/realms/score/protocol/openid-connect/certs
OIDC_AUDIENCE=score-api
OIDC_TENANT_CLAIM=tenant
