# Copy thành .env ở thư mục gốc (đọc bởi docker compose). KHÔNG commit .env.
COMPOSE_PROJECT_NAME=score

NGINX_PORT=6868
POSTGRES_PORT=5442

# UID/GID của user trên máy (lệnh: id -u ; id -g) để file tạo trong container không thuộc root
UID=1000
GID=1000

POSTGRES_PASSWORD=score
KEYCLOAK_ADMIN_PASSWORD=admin

# TẠM THỜI khi chưa có SSO: khoá của client Keycloak "score-temp-accounts" (lệnh tạo: openssl rand -hex 24)
TEMP_ACCOUNTS_CLIENT_SECRET=

# Mô hình AI đọc ảnh minh chứng (cần GPU, xem service vlm trong docker-compose.yml). Trống = tắt
VLM_URL=
VLM_MODEL=qwen2.5vl:7b
