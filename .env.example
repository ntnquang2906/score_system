# Copy thành .env ở thư mục gốc (đọc bởi docker compose). KHÔNG commit .env.
COMPOSE_PROJECT_NAME=score

NGINX_PORT=6868
POSTGRES_PORT=5442

# UID/GID của user trên máy (lệnh: id -u ; id -g) để file tạo trong container không thuộc root
UID=1000
GID=1000

POSTGRES_PASSWORD=score
KEYCLOAK_ADMIN_PASSWORD=admin
